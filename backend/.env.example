GEMINI_API_KEY=your_gemini_api_key_here
GMAIL_LABELS=bank-alerts
FETCH_WINDOW_HOURS=24

# Optional tuning
# GEMINI_BATCH_SIZE=20
# OVERLAP_BUFFER_MINUTES=10
# Retention must be >= FETCH_WINDOW_HOURS + (OVERLAP_BUFFER_MINUTES / 60)
# Default: FETCH_WINDOW_HOURS + 24 (e.g. 24h window → 48h retention, 96h window → 120h retention)
# PROCESSED_EMAILS_RETENTION_HOURS=48

# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — enables automatic schema sync (CREATE TABLE IF NOT EXISTS) on `npm start`
# Get from: Supabase Dashboard → Project Settings → Database → Connection String → "Session pooler"
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
