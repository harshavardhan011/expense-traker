GEMINI_API_KEY=your_gemini_api_key_here
GMAIL_LABELS=bank-alerts
FETCH_WINDOW_HOURS=24

# Optional tuning
# GEMINI_BATCH_SIZE=20
# OVERLAP_BUFFER_MINUTES=10
# Retention must be >= FETCH_WINDOW_HOURS + (OVERLAP_BUFFER_MINUTES / 60)
# Default: FETCH_WINDOW_HOURS + 24 (e.g. 24h window → 48h retention, 96h window → 120h retention)
# PROCESSED_EMAILS_RETENTION_HOURS=48

# Local PostgreSQL connection — all data stays on this machine.
# Install PostgreSQL locally, create a database (e.g. `expense_tracker`), then point this at it.
# Use 127.0.0.1 (not localhost) to avoid IPv6 resolution issues on Windows.
# Schema (tables + functions) is auto-created/synced on startup from db/schema.sql.
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5432/expense_tracker
